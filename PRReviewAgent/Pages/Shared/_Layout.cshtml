<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PRReviewAgent Statistics</title>
    <link rel="stylesheet" href="/css/statistics.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
</head>
<body>
    <header>
        <nav class="top-nav">
            <span class="top-nav-brand">PRReviewAgent</span>
            @{
                string currentPath = Context.Request.Path.ToString().TrimEnd('/').ToLowerInvariant();
            }
            <a href="/statistics" class="@(currentPath == "/statistics" ? "active" : "")">Overview</a>
            <a href="/statistics/reviews" class="@(currentPath == "/statistics/reviews" ? "active" : "")">Reviews</a>
            <a href="/statistics/rules" class="@(currentPath == "/statistics/rules" ? "active" : "")">Rules</a>
            <a href="/statistics/projects" class="@(currentPath == "/statistics/projects" ? "active" : "")">Projects</a>
        </nav>
    </header>
    <main class="main-content">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
